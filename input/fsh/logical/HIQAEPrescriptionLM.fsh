Mapping: HIQAEPrescriptionLMToIECore
Source: HIQAEPrescriptionLM
Target: "https://hl7-ie.github.io/medication-events/fhir"
Id: ie-core
Title: "IE Core profiles"
Description: "How each HIQA EP element is represented in IE Core. GAP = not represented."
* patientDetails.nameDetails.nameTitle -> "IEMpdPatientEPrescription: Patient.name.prefix" "Aligned"
* patientDetails.nameDetails.forename -> "IEMpdPatientEPrescription: Patient.name.given" "Aligned. given 1..* in the ePrescription patient"
* patientDetails.nameDetails.surname -> "IEMpdPatientEPrescription: Patient.name.family" "Aligned. family 1..1 in the ePrescription patient"
* patientDetails.nameDetails.nameSuffix -> "IEMpdPatientEPrescription: Patient.name.suffix" "Aligned"
* patientDetails.address.postcode -> "IEMpdPatientEPrescription: Patient.address.postalCode" "Aligned. Eircode format XXX XXXX (guidance only)"
* patientDetails.address.addressLineS -> "IEMpdPatientEPrescription: Patient.address.line" "Aligned. address 1..* and line 1..*"
* patientDetails.address.suburbTownTownlandLocality -> "IEMpdPatientEPrescription: Patient.address.city" "Aligned. Dublin postal districts go here per HIQA"
* patientDetails.address.districtCounty -> "IEMpdPatientEPrescription: Patient.address.state" "Aligned. state 1..1; IE county binding (extensible)"
* patientDetails.address.country -> "IEMpdPatientEPrescription: Patient.address.country" "Aligned"
* patientDetails.address.addressType -> "IEMpdPatientEPrescription: Patient.address.use" "Partial. use 1..1 MS; no HL7 code for homelessness (Requires Clarification)"
